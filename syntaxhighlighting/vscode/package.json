{
  "name": "riscv",
  "displayName": "RISC-V Assembly",
  "description": "RISC-V syntax highlighting for assembly supported by Risclet.",
  "version": "0.1.0",
  "publisher": "russross",
  "license": "AGPL-3.0-only",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "riscv",
        "aliases": [
          "RISC-V",
          "riscv"
        ],
        "extensions": [
          ".s"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "riscv",
        "scopeName": "source.riscv",
        "path": "./syntaxes/riscv.tmLanguage.json"
      }
    ]
  }
}
